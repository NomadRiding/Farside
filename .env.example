# Stripe (server-side — do NOT prefix with VITE_)
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_HALF_DAY=price_your_half_day_price_id
STRIPE_PRICE_FULL_DAY=price_your_full_day_price_id
SITE_URL=http://localhost:5173

# Stripe (client-side — optional, for future Stripe.js usage)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
VITE_STRIPE_PRICE_HALF_DAY=price_your_half_day_price_id
VITE_STRIPE_PRICE_FULL_DAY=price_your_full_day_price_id
